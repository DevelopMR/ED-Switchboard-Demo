{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SharePointListSchemaPlaceholder",
  "description": "Placeholder structure for documenting SharePoint list scaffolding during the planning phase.",
  "type": "object",
  "required": [
    "listName",
    "module",
    "fields"
  ],
  "properties": {
    "listName": {
      "type": "string"
    },
    "module": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "internalName",
          "type"
        ],
        "properties": {
          "internalName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
